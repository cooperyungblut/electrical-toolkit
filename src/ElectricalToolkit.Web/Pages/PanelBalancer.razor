@page "/"
@using System.Globalization
@using System.Net
@using ElectricalToolkit.Web.Models
@inject HttpClient Http

<PageTitle>Panel load balancer</PageTitle>

<h1>Panel load balancer</h1>
<p class="text-muted">
    Enter the panel and its loads, then balance. Blank names become UL plus the row number.
    To add to an existing panel, put each existing breaker's slot in Pin and it stays where it is.
</p>

<section class="mb-4">
    <h2 class="h5">Panel</h2>
    <div class="row g-3">
        <div class="col-auto">
            <label class="form-label" for="system">System</label>
            <select id="system" class="form-select" @bind="system">
                <option value="ThreePhase208Y120">208Y/120V, 3-phase</option>
                <option value="ThreePhase480Y277">480Y/277V, 3-phase</option>
                <option value="SinglePhase120240">120/240V, 1-phase</option>
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label" for="spaces">Spaces</label>
            <input id="spaces" type="number" class="form-control" min="2" step="2" @bind="spaces" />
        </div>
    </div>
</section>

<section class="mb-4">
    <h2 class="h5">Loads</h2>
    <table class="table table-sm align-middle load-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th class="text-end">VA</th>
                <th>Poles</th>
                <th title="Slot of an existing breaker. Leave blank to let the balancer choose.">Pin</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < loads.Count; i++)
            {
                // Copy the loop variables: the lambdas below run later, after the loop has moved on.
                var row = loads[i];
                var number = i + 1;
                <tr @key="row">
                    <td class="text-muted">@number</td>
                    <td><input class="form-control form-control-sm" placeholder="UL@(number)" @bind="row.Name" /></td>
                    <td><input type="number" class="form-control form-control-sm text-end" min="1" @bind="row.Va" /></td>
                    <td>
                        <select class="form-select form-select-sm" @bind="row.Poles">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                        </select>
                    </td>
                    <td><input type="number" class="form-control form-control-sm pin-input" min="1" placeholder="auto" @bind="row.PinSlot" /></td>
                    <td><button class="btn btn-sm btn-outline-secondary" title="Remove load" @onclick="() => loads.Remove(row)">✕</button></td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-sm btn-outline-primary" @onclick="AddLoad">Add load</button>
</section>

<button class="btn btn-primary" @onclick="BalanceAsync" disabled="@busy">
    @(busy ? "Balancing..." : "Balance")
</button>

@if (error is not null)
{
    <div class="alert alert-danger mt-3">@error</div>
}

@if (result is not null)
{
    <section class="mt-4">
        <h2 class="h5">Result</h2>
        <p>Imbalance: <strong>@result.ImbalancePercent.ToString("0.0")%</strong></p>

        @foreach (var (phase, total) in result.PhaseTotals)
        {
            <div class="phase-bar">
                <span class="phase-label">@phase</span>
                <div class="phase-track">
                    <div class="phase-fill" style="width: @BarWidth(total)%"></div>
                </div>
                <span class="phase-value">@total.ToString("N0") VA</span>
                <span class="phase-amps">@result.PhaseAmps[phase].ToString("0.0") A</span>
            </div>
        }

        <h3 class="h6 mt-4">Panel schedule</h3>
        <table class="table table-sm table-bordered schedule">
            <thead>
                <tr>
                    <th>Ckt</th>
                    <th>Load</th>
                    <th class="text-end">VA</th>
                    <th class="text-center">Phase</th>
                    <th class="text-end">VA</th>
                    <th>Load</th>
                    <th>Ckt</th>
                </tr>
            </thead>
            <tbody>
                @for (int left = 1; left < spacesBalanced; left += 2)
                {
                    var right = left + 1;
                    var l = PlacementAt(left);
                    var r = PlacementAt(right);
                    <tr>
                        <td>@left</td>
                        <td>@SlotLabel(l, left)</td>
                        <td class="text-end">@VaAt(l)</td>
                        <td class="text-center">@PhaseOfRow(left)</td>
                        <td class="text-end">@VaAt(r)</td>
                        <td>@SlotLabel(r, right)</td>
                        <td>@right</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private string system = "ThreePhase208Y120";
    private int spaces = 42;

    // Starts with an example where largest-first greedy alone gets 7/6/5 kVA on the 1-pole loads and
    // local search gets 6/6/6. The 3-pole unit adds the same to every phase, so it doesn't change that.
    private readonly List<LoadRow> loads =
    [
        new() { Name = "Rooftop unit", Va = 9000, Poles = 3 },
        new() { Name = "Kitchen equipment", Va = 6000 },
        new() { Name = "Receptacles - Office", Va = 3000 },
        new() { Name = "Receptacles - Break room", Va = 3000 },
        new() { Name = "Lighting - North", Va = 2000 },
        new() { Name = "Lighting - South", Va = 2000 },
        new() { Name = "Exhaust fans", Va = 2000 },
    ];

    private BalanceResponse? result;
    private int spacesBalanced;   // the spaces the current result was balanced for
    private string? error;
    private bool busy;

    private void AddLoad() => loads.Add(new LoadRow());

    private async Task BalanceAsync()
    {
        busy = true;
        error = null;
        try
        {
            // 1. Build a BalanceRequest from system, spaces and loads.
            var balanceRequest = new BalanceRequest(system, spaces,
                loads.Select(l => new LoadRequest(l.Name, l.Va, l.Poles, l.PinSlot)).ToList());
            // 2. POST it to "api/panels/balance".
            var response = await Http.PostAsJsonAsync("api/panels/balance", balanceRequest);
            // 3. On success: read the BalanceResponse into result, and set spacesBalanced = spaces.
            if (response.IsSuccessStatusCode)
            {   
                result = await response.Content.ReadFromJsonAsync<BalanceResponse>();
                spacesBalanced = spaces;
            }
            // 4. Otherwise: read a Problem, set error to its Detail (or its Title if Detail is null), and clear result.
            else
            {
                var problem = await response.Content.ReadFromJsonAsync<Problem>();
                error = problem?.Detail ?? problem?.Title ?? "The request failed.";
                result = null;
            }
        }
        catch (HttpRequestException)
        {
            error = "Couldn't reach the server. If the app was idle it may be starting up, so try again in a few seconds.";
        }
        finally
        {
            busy = false;
        }
    }

    // The placement whose Slots include this slot, or null if the slot is empty.
    private PlacementResponse? PlacementAt(int slot) =>
        result?.Placements.FirstOrDefault(p => p.Slots.Contains(slot));

    // Rows of slots cycle through the phases (A, B, C, A, ...), the same rule the API uses.
    // The result's phase totals list the panel's phases in order.
    private string PhaseOfRow(int slot)
    {
        var phases = result!.PhaseTotals.Keys.ToList();
        return phases[(slot - 1) / 2 % phases.Count];
    }

    // What a schedule cell shows for one slot. A multi-pole breaker shows its name and pole count
    // in its first slot, and a muted continuation mark in the slots below it.
    private RenderFragment? SlotLabel(PlacementResponse? placement, int slot) => placement switch
    {
        null => null,
        _ when placement.Slots[0] != slot => @<span class="text-muted">↳ @placement.Name</span>,
        _ => @<span>
                @placement.Name
                @if (placement.Poles > 1)
                {
                    <span class="badge text-bg-secondary ms-1">@(placement.Poles)P</span>
                }
                @if (placement.Pinned)
                {
                    <span class="badge text-bg-info ms-1" title="Pinned: kept in its existing slot">pinned</span>
                }
            </span>,
    };

    // A multi-pole load's VA is split equally across its poles, so each slot shows its share.
    private static string? VaAt(PlacementResponse? placement) =>
        placement is null ? null : (placement.Va / placement.Poles).ToString("N0");

    // Each bar's length is its phase's share of the heaviest phase, so the heaviest is always full width.
    private string BarWidth(double total)
    {
        var max = result!.PhaseTotals.Values.Max();
        var percent = max == 0 ? 0 : total / max * 100;
        // CSS needs a dot as the decimal separator, whatever the browser's language.
        return percent.ToString("0.#", CultureInfo.InvariantCulture);
    }
}